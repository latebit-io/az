### Copy this file to az.http and adjust values. Requires a running az service.

@host = http://localhost:8080
# When API_KEY_ENABLED=true add to each request:
# X-AZ-API-KEY: your-api-key

### Health
GET {{host}}/health

### Create a resource type
POST {{host}}/api/resources
Content-Type: application/json

{
  "tenantId": "default",
  "key": "document",
  "actions": ["read", "write", "delete"]
}

### Get a resource type
POST {{host}}/api/resources/get
Content-Type: application/json

{
  "tenantId": "default",
  "key": "document"
}

### List resource types
POST {{host}}/api/resources/list
Content-Type: application/json

{
  "tenantId": "default"
}

### Update a resource type's actions
PUT {{host}}/api/resources
Content-Type: application/json

{
  "tenantId": "default",
  "key": "document",
  "actions": ["read", "write", "delete", "share"]
}

### Create a role
POST {{host}}/api/roles
Content-Type: application/json

{
  "tenantId": "default",
  "key": "editor",
  "name": "Editor",
  "description": "can read and write documents",
  "permissions": [
    {"resource": "document", "action": "read"},
    {"resource": "document", "action": "write"}
  ]
}

### List roles
POST {{host}}/api/roles/list
Content-Type: application/json

{
  "tenantId": "default"
}

### Assign a role
POST {{host}}/api/assignments
Content-Type: application/json

{
  "tenantId": "default",
  "subject": "user@example.com",
  "role": "editor"
}

### List assignments (filter by subject and/or role)
POST {{host}}/api/assignments/list
Content-Type: application/json

{
  "tenantId": "default",
  "subject": "user@example.com"
}

### Roles for a subject (for JWT roles claim)
POST {{host}}/api/subjects/roles
Content-Type: application/json

{
  "tenantId": "default",
  "key": "user@example.com"
}

### Check
POST {{host}}/api/check
Content-Type: application/json

{
  "tenantId": "default",
  "subject": "user@example.com",
  "action": "write",
  "resource": "document"
}

### Bulk check
POST {{host}}/api/check/bulk
Content-Type: application/json

{
  "tenantId": "default",
  "checks": [
    {"subject": "user@example.com", "action": "write", "resource": "document"},
    {"subject": "user@example.com", "action": "delete", "resource": "document"}
  ]
}

### Remove an assignment
PUT {{host}}/api/assignments/delete
Content-Type: application/json

{
  "tenantId": "default",
  "subject": "user@example.com",
  "role": "editor"
}

### Delete a role (cascades its assignments)
PUT {{host}}/api/roles/delete
Content-Type: application/json

{
  "tenantId": "default",
  "key": "editor"
}

### Delete a resource type (409 while roles reference it)
PUT {{host}}/api/resources/delete
Content-Type: application/json

{
  "tenantId": "default",
  "key": "document"
}
