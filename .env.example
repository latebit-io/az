# az configuration

# HTTP port (default 8080)
PORT=8080

# PostgreSQL connection string
DB_CONNECTION=postgres://az:az@localhost:5432/az?sslmode=disable

# Rate limit (requests per second, default 20)
REQUESTS_PER_SECOND=20

# Root credential (header X-AZ-API-KEY). When set, every endpoint except
# /health requires a key: this bootstrap key (any tenant + key management)
# or a tenant-scoped key minted via POST /api/apikeys.
# When empty, api key auth is DISABLED — dev only.
BOOTSTRAP_API_KEY=

# CORS
CORS_ENABLED=false
ALLOWED_WEB_ORIGINS=
DOMAIN=

# Log every check decision via slog (default true)
DECISION_LOG_ENABLED=true

# Default tenant id (default "default")
DEFAULT_TENANT_ID=default
