# az configuration

# HTTP port (default 8080)
PORT=8080

# PostgreSQL connection string
DB_CONNECTION=postgres://az:az@localhost:5432/az?sslmode=disable

# Rate limit (requests per second, default 20)
REQUESTS_PER_SECOND=20

# API key auth for all endpoints (header X-AZ-API-KEY)
API_KEY_ENABLED=false
API_KEY=

# CORS
CORS_ENABLED=false
ALLOWED_WEB_ORIGINS=
DOMAIN=

# Log every check decision via slog (default true)
DECISION_LOG_ENABLED=true

# Default tenant id (default "default")
DEFAULT_TENANT_ID=default
